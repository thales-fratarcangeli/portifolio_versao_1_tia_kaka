---
import BaseLayout from './BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppFloat from '@components/WhatsAppFloat.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  author?: string;
  prev?: { slug: string; data: { title: string } } | null;
  next?: { slug: string; data: { title: string } } | null;
}

const { title, description, pubDate, category, author, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(pubDate);

const categoryLabel: Record<string, string> = {
  pintura: 'Pintura',
  tecnicas: 'Técnicas',
};
---

<BaseLayout title={`${title} · Blog Tia Kaka`} description={description}>
  <Header />

  <main id="main" class="pt-32 md:pt-36 pb-16">
    <article class="container-soft max-w-3xl">
      <a
        href={`${base}/blog`}
        class="inline-flex items-center gap-2 text-sm font-semibold mb-8 transition-colors hover:opacity-80"
        style="color: var(--color-terracota);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Voltar para o blog
      </a>

      <header class="mb-10">
        <div class="flex items-center gap-3 mb-5 text-sm">
          <span class="pill" style="background: var(--color-terracota); color: var(--color-cream); border-color: var(--color-terracota);">
            {categoryLabel[category] ?? category}
          </span>
          <time datetime={pubDate.toISOString()} style="color: rgba(44,36,22,0.6);">
            {formattedDate}
          </time>
        </div>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight text-balance" style="color: var(--color-tinta);">
          {title}
        </h1>
        <p class="text-xl leading-relaxed" style="color: rgba(44,36,22,0.8);">
          {description}
        </p>
        {author && (
          <p class="mt-4 text-sm font-semibold" style="color: rgba(44,36,22,0.6);">
            Por {author}
          </p>
        )}
      </header>

      <div class="prose prose-lg max-w-none blog-content">
        <slot />
      </div>

      <nav class="mt-16 pt-8 border-t grid sm:grid-cols-2 gap-4" style="border-color: rgba(44,36,22,0.12);" aria-label="Navegação entre posts">
        {prev ? (
          <a
            href={`${base}/blog/${prev.slug}`}
            class="glass-card p-5 block group"
          >
            <p class="text-xs uppercase tracking-widest font-bold mb-2 flex items-center gap-1" style="color: var(--color-terracota);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              Anterior
            </p>
            <p class="font-display text-lg font-bold group-hover:underline" style="color: var(--color-tinta);">
              {prev.data.title}
            </p>
          </a>
        ) : <span></span>}
        {next ? (
          <a
            href={`${base}/blog/${next.slug}`}
            class="glass-card p-5 block group text-right"
          >
            <p class="text-xs uppercase tracking-widest font-bold mb-2 flex items-center justify-end gap-1" style="color: var(--color-terracota);">
              Próximo
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </p>
            <p class="font-display text-lg font-bold group-hover:underline" style="color: var(--color-tinta);">
              {next.data.title}
            </p>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style is:global>
  .blog-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-tinta);
  }
  .blog-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-tinta);
  }
  .blog-content p {
    font-size: 1.125rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: rgba(44,36,22,0.85);
  }
  .blog-content strong { color: var(--color-tinta); }
  .blog-content em { color: var(--color-terracota); font-style: italic; }
  .blog-content ul {
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0;
  }
  .blog-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .blog-content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    background: var(--color-terracota);
    border-radius: 50% 30% 50% 40%;
  }
  .blog-content a {
    color: var(--color-terracota);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
