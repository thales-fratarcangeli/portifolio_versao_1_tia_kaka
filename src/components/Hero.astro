---
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-x-clip overflow-y-visible pt-28 md:pt-32 pb-16"
  style="max-width: 100vw;"
>
  <div class="absolute inset-0 -z-10 noise">
    <div
      class="absolute inset-0"
      style="background: radial-gradient(1200px 600px at 12% 18%, rgba(193,105,79,0.18), transparent 60%), radial-gradient(900px 500px at 88% 82%, rgba(122,140,94,0.16), transparent 60%);"
      aria-hidden="true"
    ></div>

    <svg
      class="absolute top-20 -right-16 w-[520px] max-w-[70vw] opacity-40 brush-stroke"
      viewBox="0 0 500 500"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M20 250 C 120 80, 320 60, 460 180 S 460 420, 260 440"
        stroke="#C1694F"
        stroke-width="28"
        stroke-linecap="round"
        fill="none"
        stroke-dasharray="1200"
        stroke-dashoffset="1200"
      />
    </svg>

    <svg
      class="absolute -bottom-24 -left-20 w-[420px] max-w-[60vw] opacity-30 brush-stroke"
      viewBox="0 0 500 500"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M40 460 C 140 320, 280 260, 420 340 S 420 140, 200 120"
        stroke="#7A8C5E"
        stroke-width="22"
        stroke-linecap="round"
        fill="none"
        stroke-dasharray="1200"
        stroke-dashoffset="1200"
      />
    </svg>

    <svg
      class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[380px] max-w-[50vw] opacity-25 brush-stroke blur-[2px]"
      viewBox="0 0 500 120"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M10 60 Q 130 10, 250 60 T 490 60"
        stroke="#D9A441"
        stroke-width="18"
        stroke-linecap="round"
        fill="none"
        stroke-dasharray="800"
        stroke-dashoffset="800"
      />
    </svg>
  </div>

  <div class="container-wide relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <p
          id="hero-kicker"
          class="reveal-hidden section-kicker inline-flex items-center gap-2"
        >
          <span class="inline-block w-8 h-[2px]" style="background: var(--color-terracota);"></span>
          São Joaquim da Barra · SP
        </p>

        <h1
          id="hero-title"
          class="reveal-hidden font-display font-bold text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] leading-[1.05] mb-6 text-balance"
          style="color: var(--color-tinta);"
        >
          Desperte o
          <span class="brush-underline italic" style="color: var(--color-terracota);">artista</span>
          que vive em você
        </h1>

        <p
          id="hero-sub"
          class="reveal-hidden text-lg md:text-xl max-w-xl mb-10"
          style="color: rgba(44, 36, 22, 0.78);"
        >
          Aulas de pintura, desenho e arteterapia para todas as idades, conduzidas por
          <strong style="color: var(--color-tinta);">Klara Bosso — Tia Kaka</strong>.
          Um ateliê que celebra cada pincelada, cada traço, cada história.
        </p>

        <div id="hero-ctas" class="reveal-hidden flex flex-wrap gap-3">
          <a
            href="https://wa.me/5516991468916?text=Ol%C3%A1%2C%20Tia%20Kaka!"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Agendar uma aula
          </a>
          <a href="#atividades" class="btn btn-secondary">
            Conhecer as aulas
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </a>
        </div>

        <div
          id="hero-proof"
          class="reveal-hidden mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm font-semibold"
          style="color: rgba(44, 36, 22, 0.7);"
        >
          <span class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
            +15 alunos
          </span>
          <span class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="10"/></svg>
            +2 anos de ateliê
          </span>
          <span class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19l4-12 4 9 4-6 4 9"/></svg>
            4 modalidades
          </span>
        </div>
      </div>

      <div class="lg:col-span-5 relative" id="hero-visual">
        <div class="reveal-hidden relative w-full aspect-[4/5] max-w-md mx-auto">
          <div
            class="absolute inset-0 rotate-[-3deg] rounded-[38%_62%_48%_52%/55%_40%_60%_45%]"
            style="background: linear-gradient(160deg, var(--color-terracota) 0%, var(--color-ocre) 100%); box-shadow: 0 30px 60px -30px rgba(44,36,22,0.35);"
            aria-hidden="true"
          ></div>
          <div
            class="absolute inset-3 rotate-[2deg] rounded-[55%_45%_55%_45%/45%_55%_40%_60%] overflow-hidden"
            style="background: var(--color-areia);"
          >
            <!-- SUBSTITUIR: foto/ilustração da Klara pintando -->
            <div class="img-placeholder w-full h-full" style="border-radius: inherit;">
              <div class="text-center px-6">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-terracota); margin: 0 auto 12px;" aria-hidden="true">
                  <circle cx="13.5" cy="6.5" r="0.5" fill="currentColor"/>
                  <circle cx="17.5" cy="10.5" r="0.5" fill="currentColor"/>
                  <circle cx="8.5" cy="7.5" r="0.5" fill="currentColor"/>
                  <circle cx="6.5" cy="12.5" r="0.5" fill="currentColor"/>
                  <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.8 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.5-1-.3-.3-.5-.7-.5-1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5-4.5-9-10-9z"/>
                </svg>
                <p style="color: var(--color-tinta); opacity:.6; font-size: .75rem;">SUBSTITUIR · Foto da Klara</p>
                <p style="color: var(--color-tinta); opacity:.4; font-size: .65rem;">/images/klara-profile.jpg</p>
              </div>
            </div>
          </div>

          <!-- Paleta decorativa flutuante -->
          <div
            class="absolute -bottom-6 -left-6 w-28 h-28 rotate-12 glass-card flex items-center justify-center animate-float"
            aria-hidden="true"
          >
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracota)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r="0.8" fill="var(--color-oliva, #7A8C5E)"/>
              <circle cx="17.5" cy="10.5" r="0.8" fill="var(--color-ocre, #D9A441)"/>
              <circle cx="8.5" cy="7.5" r="0.8" fill="var(--color-terracota)"/>
              <circle cx="6.5" cy="12.5" r="0.8" fill="var(--color-tinta)"/>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.8 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.5-1-.3-.3-.5-.7-.5-1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5-4.5-9-10-9z"/>
            </svg>
          </div>

          <div
            class="absolute -top-4 -right-4 px-4 py-2 rotate-6 font-display italic text-sm shadow-handmade"
            style="background: var(--color-cream); color: var(--color-tinta); border: 1.5px solid var(--color-tinta); border-radius: 8px 12px 10px 14px;"
            aria-hidden="true"
          >
            "pinte sua história"
          </div>
        </div>
      </div>
    </div>

    <a
      href="#sobre"
      class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-xs uppercase tracking-[0.3em] font-bold opacity-70 hover:opacity-100 transition-opacity"
      style="color: var(--color-tinta);"
      aria-label="Rolar para saber mais"
    >
      Role
      <span class="w-[2px] h-10 relative overflow-hidden rounded-full" style="background: rgba(44,36,22,0.2);" aria-hidden="true">
        <span class="absolute top-0 left-0 w-full h-1/2 rounded-full hero-scroll-dot" style="background: var(--color-tinta);"></span>
      </span>
    </a>
  </div>
</section>

<style>
  @keyframes heroScroll {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
  .hero-scroll-dot {
    animation: heroScroll 1.6s ease-in-out infinite;
  }
</style>

<script>
  import { animate, stagger } from 'motion';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const targets = [
    '#hero-kicker',
    '#hero-title',
    '#hero-sub',
    '#hero-ctas',
    '#hero-proof',
    '#hero-visual .reveal-hidden',
  ].map((sel) => document.querySelector(sel)).filter(Boolean) as Element[];

  if (reduceMotion) {
    targets.forEach((el) => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.transform = 'none';
    });
  } else {
    animate(
      targets,
      { opacity: [0, 1], transform: ['translateY(24px)', 'translateY(0)'] },
      { duration: 0.8, delay: stagger(0.12, { start: 0.1 }), easing: [0.22, 1, 0.36, 1] },
    );

    document.querySelectorAll<SVGPathElement>('.brush-stroke path').forEach((path, i) => {
      animate(
        path,
        { strokeDashoffset: [1200, 0] },
        { duration: 2.4, delay: 0.4 + i * 0.2, easing: [0.22, 1, 0.36, 1] },
      );
    });
  }
</script>
