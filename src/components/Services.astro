---
const services = [
  {
    title: 'Pintura em Tela',
    ages: 'Todas as idades',
    description:
      'Técnicas variadas — do iniciante ao avançado. Aquarela, acrílica, óleo e suas primeiras obras emolduradas.',
    iconId: 'brush',
    waMessage: 'Ol%C3%A1%20Tia%20Kaka%2C%20tenho%20interesse%20nas%20aulas%20de%20Pintura%20em%20Tela!',
  },
  {
    title: 'Desenho Artístico',
    ages: 'A partir de 7 anos',
    description:
      'Fundamentos de proporção, luz, sombra e estilo livre. Aprenda a observar e registrar o mundo com traços próprios.',
    iconId: 'pencil',
    waMessage: 'Ol%C3%A1%20Tia%20Kaka%2C%20tenho%20interesse%20nas%20aulas%20de%20Desenho!',
  },
  {
    title: 'Panos de Prato',
    ages: 'Adultos',
    description:
      'Pintura decorativa em tecido com motivos autorais. Uma tradição brasileira transformada em arte contemporânea.',
    iconId: 'flower',
    waMessage: 'Ol%C3%A1%20Tia%20Kaka%2C%20tenho%20interesse%20nas%20aulas%20de%20Panos%20de%20Prato!',
  },
];

const WA_BASE = 'https://wa.me/5516991468916?text=';
---

<section id="atividades" class="section">
  <div class="container-wide">
    <div class="max-w-2xl mb-14">
      <p class="section-kicker">O que rola no ateliê</p>
      <h2 class="section-title text-balance">
        Atividades para
        <span class="brush-underline italic" style="color: var(--color-terracota);">cada mão</span>
        que quer criar
      </h2>
      <p class="section-lead mt-4">
        Todas as aulas incluem materiais, acompanhamento personalizado e, principalmente, um espaço seguro
        para errar, experimentar e descobrir seu traço.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <article
          class="service-card glass-card p-7 flex flex-col group relative overflow-hidden"
          data-tilt={i % 2 === 0 ? '-0.3' : '0.4'}
        >
          <div
            class="absolute -top-6 -right-6 w-24 h-24 rounded-full opacity-0 group-hover:opacity-20 transition-opacity duration-500"
            style="background: var(--color-terracota);"
            aria-hidden="true"
          ></div>

          <div
            class="w-14 h-14 rounded-2xl grid place-items-center mb-5 shrink-0"
            style="background: rgba(193, 105, 79, 0.12); color: var(--color-terracota);"
            aria-hidden="true"
          >
            {service.iconId === 'brush' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>
              </svg>
            )}
            {service.iconId === 'pencil' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>
              </svg>
            )}
            {service.iconId === 'flower' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M12 9V2M12 22v-7M19.07 4.93l-4.95 4.95M9.88 14.12 4.93 19.07M22 12h-7M9 12H2M19.07 19.07l-4.95-4.95M9.88 9.88 4.93 4.93"/>
              </svg>
            )}
            {service.iconId === 'heart' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            )}
          </div>

          <h3 class="font-display text-2xl font-bold mb-1" style="color: var(--color-tinta);">
            {service.title}
          </h3>
          <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-verde-oliva-dark);">
            {service.ages}
          </p>
          <p class="text-base mb-6 flex-1" style="color: rgba(44,36,22,0.78);">
            {service.description}
          </p>

          <a
            href={WA_BASE + service.waMessage}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp w-full text-sm"
            aria-label={`Falar no WhatsApp sobre ${service.title}`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quero saber mais
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  @media (min-width: 640px) {
    .service-card[data-tilt="-0.3"] { transform: rotate(-0.3deg); }
    .service-card[data-tilt="0.4"]  { transform: rotate(0.4deg); }
  }
  @media (hover: hover) and (min-width: 640px) {
    .service-card:hover {
      transform: translateY(-8px) rotate3d(1, -1, 0, 4deg) !important;
      box-shadow: 0 30px 50px -20px rgba(44, 36, 22, 0.28);
    }
  }
</style>
