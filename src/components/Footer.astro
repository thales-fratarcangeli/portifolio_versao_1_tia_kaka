---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const quickLinks = [
  { href: '#sobre',        label: 'Sobre' },
  { href: '#atividades',   label: 'Atividades' },
  { href: '#turmas',       label: 'Turmas' },
  { href: '#galeria',      label: 'Galeria' },
  { href: '#faq',          label: 'FAQ' },
  { href: '#contato',      label: 'Contato' },
  { href: `${base}/blog`,  label: 'Blog' },
];
---

<footer
  class="relative pt-16 pb-10 overflow-hidden"
  style="background: var(--color-tinta); color: var(--color-cream);"
>
  <div class="painted-divider mb-12" aria-hidden="true"></div>

  <div class="container-wide grid md:grid-cols-[1.2fr_1fr_1fr] gap-10 md:gap-14">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span
          class="w-12 h-12 rounded-full grid place-items-center"
          style="background: var(--color-terracota); color: var(--color-cream); font-family: 'Playfair Display', serif; font-style: italic; font-weight: 900; font-size: 1.6rem;"
          aria-hidden="true"
        >K</span>
        <div>
          <p class="font-display text-2xl font-bold leading-tight">Tia Kaka</p>
          <p class="text-xs uppercase tracking-[0.25em] font-semibold" style="color: var(--color-terracota);">
            Arte que transforma
          </p>
        </div>
      </div>
      <p class="text-sm leading-relaxed max-w-sm" style="color: rgba(250,246,240,0.7);">
        Aulas de pintura, desenho e arteterapia para todas as idades, em São Joaquim da Barra - SP.
        Um ateliê onde cada pessoa descobre sua voz artística.
      </p>
    </div>

    <nav aria-label="Links rápidos">
      <h2 class="font-display text-lg font-bold mb-4">Navegação</h2>
      <ul class="space-y-2 text-sm">
        {quickLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-block transition-colors hover:text-white"
              style="color: rgba(250,246,240,0.75);"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-lg font-bold mb-4">Onde me encontrar</h2>
      <ul class="space-y-3 text-sm">
        <li>
          <a
            href="https://wa.me/5516991468916"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition-colors hover:text-white"
            style="color: rgba(250,246,240,0.85);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            +55 16 99146-8916
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/borboletasemdesenvolvimento/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition-colors hover:text-white"
            style="color: rgba(250,246,240,0.85);"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            @borboletasemdesenvolvimento
          </a>
        </li>
        <li>
          <span class="inline-flex items-start gap-2" style="color: rgba(250,246,240,0.85);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Rua Rio Grande do Norte, 1619<br/>
            São Joaquim da Barra - SP
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container-wide mt-12 pt-6 border-t" style="border-color: rgba(250,246,240,0.1);">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs" style="color: rgba(250,246,240,0.55);">
      <p>
        © {year} Klara Bosso · Feito com
        <span aria-label="muita arte"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block align-middle" style="color: var(--color-terracota);"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.8 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.5-1-.3-.3-.5-.7-.5-1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5-4.5-9-10-9z"/></svg></span>
        em São Joaquim da Barra
      </p>
      <p class="opacity-80">Borboletas em Desenvolvimento</p>
    </div>
  </div>
</footer>
