---
const contacts = [
  {
    id: 'whatsapp',
    title: 'WhatsApp',
    value: '+55 16 99146-8916',
    href: 'https://wa.me/5516991468916?text=Ol%C3%A1%2C%20Tia%20Kaka!',
    description: 'Resposta rápida durante o horário comercial',
    icon: 'whatsapp',
  },
  {
    id: 'instagram',
    title: 'Instagram',
    value: '@borboletasemdesenvolvimento',
    href: 'https://www.instagram.com/borboletasemdesenvolvimento/',
    description: 'Fotos do dia a dia do ateliê e das obras',
    icon: 'instagram',
  },
  {
    id: 'address',
    title: 'Endereço do ateliê',
    value: 'Rua Rio Grande do Norte, 1619',
    href: 'https://maps.google.com/?q=Rua+Rio+Grande+do+Norte,1619,S%C3%A3o+Joaquim+da+Barra',
    description: 'São Joaquim da Barra — SP · 14600-000',
    icon: 'pin',
  },
];
---

<section id="contato" class="section" style="background: var(--color-cream);">
  <div class="container-wide">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="section-kicker">Vamos conversar</p>
      <h2 class="section-title text-balance">
        Onde a
        <span class="brush-underline italic" style="color: var(--color-terracota);">arte</span>
        acontece
      </h2>
      <p class="section-lead mx-auto mt-4">
        Dúvidas, matrículas, encomendas ou só um oi — escolha o canal que preferir.
      </p>
    </div>

    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-8 items-stretch">
      <div class="relative rounded-3xl overflow-hidden shadow-organic" style="background: var(--color-areia);">
        <iframe
          src="https://maps.google.com/maps?q=Rua+Rio+Grande+do+Norte,+1619,+S%C3%A3o+Joaquim+da+Barra,+SP&output=embed"
          width="100%"
          height="100%"
          style="border: 0; min-height: 460px; display: block;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização do ateliê da Tia Kaka"
          aria-label="Mapa mostrando a localização do ateliê da Tia Kaka em São Joaquim da Barra"
        ></iframe>

        <!-- Fallback visível se iframe for bloqueado -->
        <div
          class="absolute inset-0 flex flex-col items-center justify-center text-center p-10 pointer-events-none"
          style="background: var(--color-areia); color: var(--color-tinta);"
          aria-hidden="true"
          id="map-fallback"
        ></div>
      </div>

      <div class="flex flex-col gap-4">
        {contacts.map((c) => (
          <a
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-card glass-card p-6 flex items-start gap-4 group"
            aria-label={`${c.title}: ${c.value}`}
          >
            <div
              class="w-14 h-14 rounded-2xl grid place-items-center shrink-0 transition-transform duration-300 group-hover:scale-110"
              style={c.icon === 'whatsapp'
                ? 'background: #25D366; color: white;'
                : c.icon === 'instagram'
                  ? 'background: linear-gradient(135deg,#F58529 0%,#DD2A7B 50%,#8134AF 100%); color: white;'
                  : 'background: var(--color-terracota); color: var(--color-cream);'}
              aria-hidden="true"
            >
              {c.icon === 'whatsapp' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              )}
              {c.icon === 'instagram' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              )}
              {c.icon === 'pin' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              )}
            </div>
            <div class="flex-1">
              <p class="text-xs font-bold uppercase tracking-widest mb-1" style="color: var(--color-terracota);">
                {c.title}
              </p>
              <p class="font-display text-xl md:text-2xl font-bold" style="color: var(--color-tinta);">
                {c.value}
              </p>
              <p class="text-sm mt-1" style="color: rgba(44,36,22,0.7);">{c.description}</p>
            </div>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-2 opacity-40 transition-transform duration-300 group-hover:translate-x-1" style="color: var(--color-tinta);" aria-hidden="true">
              <path d="M7 17L17 7M17 7H8M17 7v9"/>
            </svg>
          </a>
        ))}

        <a
          href="https://maps.google.com/?q=Rua+Rio+Grande+do+Norte,1619,S%C3%A3o+Joaquim+da+Barra"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary w-full"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Abrir no Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -16px rgba(44,36,22,0.25);
  }
</style>
