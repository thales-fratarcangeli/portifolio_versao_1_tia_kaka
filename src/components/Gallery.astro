---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = [
  { id: 1,  category: 'telas',  src: `${base}/images/gallery/placeholder-1.jpg`,  alt: 'Tela floral em acrílica com traços expressivos',        aspect: '4/5' },
  { id: 2,  category: 'panos',  src: `${base}/images/gallery/placeholder-2.jpg`,  alt: 'Pano de prato decorativo com frutas tropicais',          aspect: '3/4' },
  { id: 3,  category: 'alunos', src: `${base}/images/gallery/placeholder-3.jpg`,  alt: 'Aluna adulta concluindo primeira tela em óleo',           aspect: '4/3' },
  { id: 4,  category: 'telas',  src: `${base}/images/gallery/placeholder-4.jpg`,  alt: 'Paisagem de interior rural em aquarela',                 aspect: '1/1' },
  { id: 5,  category: 'alunos', src: `${base}/images/gallery/placeholder-5.jpg`,  alt: 'Criança pintando durante aula de arteterapia',            aspect: '3/4' },
  { id: 6,  category: 'panos',  src: `${base}/images/gallery/placeholder-6.jpg`,  alt: 'Pano de prato com desenho de galinhas estilizadas',       aspect: '4/5' },
  { id: 7,  category: 'telas',  src: `${base}/images/gallery/placeholder-7.jpg`,  alt: 'Retrato abstrato em tons terrosos',                       aspect: '4/3' },
  { id: 8,  category: 'alunos', src: `${base}/images/gallery/placeholder-8.jpg`,  alt: 'Turma de crianças expondo trabalhos em sala',             aspect: '4/3' },
  { id: 9,  category: 'telas',  src: `${base}/images/gallery/placeholder-9.jpg`,  alt: 'Natureza morta com flores secas em acrílica',             aspect: '3/4' },
  { id: 10, category: 'panos',  src: `${base}/images/gallery/placeholder-10.jpg`, alt: 'Pano de prato com ervas aromáticas pintadas',             aspect: '1/1' },
  { id: 11, category: 'alunos', src: `${base}/images/gallery/placeholder-11.jpg`, alt: 'Aluno avançado finalizando paisagem urbana',              aspect: '4/5' },
  { id: 12, category: 'telas',  src: `${base}/images/gallery/placeholder-12.jpg`, alt: 'Pintura abstrata em camadas de cores vibrantes',         aspect: '3/4' },
];

const filters = [
  { id: 'todos',  label: 'Todos' },
  { id: 'telas',  label: 'Telas' },
  { id: 'panos',  label: 'Panos de Prato' },
  { id: 'alunos', label: 'Alunos' },
];
---

<section id="galeria" class="section" style="background: var(--color-areia);">
  <div class="container-wide">
    <div class="max-w-2xl mb-10">
      <p class="section-kicker">Obras em movimento</p>
      <h2 class="section-title text-balance">
        Galeria da
        <span class="brush-underline italic" style="color: var(--color-terracota);">Tia Kaka</span>
      </h2>
      <p class="section-lead mt-4">
        Um recorte do que já saiu do ateliê — das primeiras experimentações de alunos iniciantes
        às composições maduras em tela e tecido.
      </p>
    </div>

    <div
      class="flex flex-wrap gap-2 mb-10"
      role="tablist"
      aria-label="Filtrar galeria por categoria"
    >
      {filters.map((f, i) => (
        <button
          type="button"
          class="filter-pill px-5 py-2 rounded-full font-semibold text-sm transition-all duration-300"
          data-filter={f.id}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>

    <div id="gallery-grid" class="gallery-masonry" aria-live="polite">
      {items.map((item, i) => (
        <button
          type="button"
          class="gallery-item block w-full mb-5 group relative overflow-hidden"
          data-category={item.category}
          data-index={i}
          data-alt={item.alt}
          aria-label={`Abrir imagem: ${item.alt}`}
        >
          {/* SUBSTITUIR: adicionar imagem real aqui */}
          <div
            class="img-placeholder w-full"
            style={`aspect-ratio: ${item.aspect};`}
          >
            <div class="text-center px-4">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="color: var(--color-terracota); margin: 0 auto 8px;" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
              <p style="font-size:.7rem; opacity:.7;">{item.alt}</p>
              <p style="font-size:.6rem; opacity:.4;">placeholder-{item.id}.jpg</p>
            </div>
          </div>

          <span
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4"
            style="background: linear-gradient(to top, rgba(44,36,22,0.7), transparent 60%);"
            aria-hidden="true"
          >
            <span class="text-cream font-semibold text-sm capitalize" style="color: var(--color-cream);">
              {item.category === 'telas' ? 'Tela' : item.category === 'panos' ? 'Pano de prato' : 'Aluno(a)'}
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center px-4"
  style="background: rgba(44, 36, 22, 0.94); backdrop-filter: blur(8px);"
  role="dialog"
  aria-modal="true"
  aria-label="Visualização ampliada da galeria"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute top-6 right-6 w-12 h-12 rounded-full grid place-items-center transition-transform hover:scale-110"
    style="background: var(--color-cream); color: var(--color-tinta);"
    aria-label="Fechar visualização"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-prev"
    class="absolute left-4 md:left-10 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full grid place-items-center transition-transform hover:scale-110"
    style="background: var(--color-cream); color: var(--color-tinta);"
    aria-label="Imagem anterior"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6"/>
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-next"
    class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full grid place-items-center transition-transform hover:scale-110"
    style="background: var(--color-cream); color: var(--color-tinta);"
    aria-label="Próxima imagem"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </button>

  <figure class="max-w-5xl max-h-[80vh] flex flex-col items-center gap-4">
    <div id="lightbox-body" class="img-placeholder flex items-center justify-center p-12" style="min-width: min(90vw, 800px); min-height: min(70vh, 600px); border-radius: 12px; color: var(--color-tinta);">
      <p class="text-sm" id="lightbox-caption-fallback">SUBSTITUIR imagem</p>
    </div>
    <figcaption id="lightbox-caption" class="text-sm font-semibold text-center max-w-xl" style="color: var(--color-cream);"></figcaption>
  </figure>
</div>

<style>
  .filter-pill {
    background: transparent;
    color: var(--color-tinta);
    border: 1.5px solid var(--color-tinta);
  }
  .filter-pill:hover {
    background: var(--color-tinta);
    color: var(--color-cream);
  }
  .filter-pill[aria-selected="true"] {
    background: var(--color-terracota);
    color: var(--color-cream);
    border-color: var(--color-terracota);
    box-shadow: 0 6px 18px -10px rgba(193,105,79,0.7);
  }

  .gallery-masonry {
    columns: 2;
    column-gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .gallery-masonry { columns: 2; }
  }
  @media (min-width: 1024px) {
    .gallery-masonry { columns: 3; }
  }

  .gallery-item {
    break-inside: avoid;
    border-radius: 14px;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  .gallery-item:hover {
    transform: translateY(-4px);
  }

  #lightbox.open {
    display: flex;
  }
</style>

<script>
  import { animate } from 'motion';

  type Item = { el: HTMLElement; category: string; alt: string };
  const allItems: Item[] = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item')).map((el) => ({
    el,
    category: el.dataset.category || '',
    alt: el.dataset.alt || '',
  }));

  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let currentFilter = 'todos';
  let filteredList: Item[] = allItems;

  function applyFilter(filter: string) {
    currentFilter = filter;
    filteredList = filter === 'todos' ? allItems : allItems.filter((it) => it.category === filter);

    allItems.forEach((it) => {
      const match = filter === 'todos' || it.category === filter;
      if (match) {
        it.el.classList.remove('hidden');
        if (!reduceMotion) {
          animate(
            it.el,
            { opacity: [0, 1], transform: ['scale(0.92)', 'scale(1)'] },
            { duration: 0.35, easing: [0.22, 1, 0.36, 1] },
          );
        } else {
          it.el.style.opacity = '1';
          it.el.style.transform = 'none';
        }
      } else {
        it.el.classList.add('hidden');
      }
    });

    pills.forEach((p) => {
      p.setAttribute('aria-selected', p.dataset.filter === filter ? 'true' : 'false');
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => applyFilter(pill.dataset.filter || 'todos'));
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxBody = document.getElementById('lightbox-body') as HTMLElement;
  const lightboxCaption = document.getElementById('lightbox-caption') as HTMLElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;

  let currentIndex = 0;

  function openLightbox(item: Item) {
    currentIndex = filteredList.indexOf(item);
    renderLightbox();
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function renderLightbox() {
    const item = filteredList[currentIndex];
    if (!item) return;
    lightboxBody.innerHTML = `
      <!-- SUBSTITUIR: exibir imagem real quando disponível -->
      <div style="text-align:center;">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" style="color: var(--color-terracota); margin: 0 auto 14px; opacity:.8;" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
        <p style="font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--color-tinta);opacity:.8;">${item.alt}</p>
        <p style="font-size:.7rem;margin-top:6px;opacity:.5;color:var(--color-tinta);">SUBSTITUIR · placeholder</p>
      </div>
    `;
    lightboxCaption.textContent = item.alt;
  }

  function closeLightbox() {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  function nav(delta: number) {
    if (!filteredList.length) return;
    currentIndex = (currentIndex + delta + filteredList.length) % filteredList.length;
    renderLightbox();
  }

  allItems.forEach((it) => {
    it.el.addEventListener('click', () => openLightbox(it));
  });

  closeBtn.addEventListener('click', closeLightbox);
  prevBtn.addEventListener('click', () => nav(-1));
  nextBtn.addEventListener('click', () => nav(1));

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') nav(-1);
    if (e.key === 'ArrowRight') nav(1);
  });
</script>
