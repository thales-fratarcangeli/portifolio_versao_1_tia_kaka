---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#atividades', label: 'Atividades' },
  { href: '#galeria', label: 'Galeria' },
  { href: '#turmas', label: 'Turmas' },
  { href: '#contato', label: 'Contato' },
  { href: `${base}/blog`, label: 'Blog' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
  data-at-top="true"
>
  <div class="container-wide">
    <nav
      class="flex items-center justify-between py-4 md:py-5"
      aria-label="Navegação principal"
    >
      <a
        href={base + '/'}
        class="group flex items-center gap-2"
        aria-label="Tia Kaka — ir para o início"
      >
        <span
          class="w-11 h-11 rounded-full grid place-items-center shrink-0"
          style="background: var(--color-terracota); color: var(--color-cream); font-family: 'Playfair Display', serif; font-style: italic; font-weight: 900; font-size: 1.4rem;"
          aria-hidden="true"
        >K</span>
        <span class="flex flex-col leading-tight">
          <span class="font-display text-xl md:text-2xl font-bold" style="color: var(--color-tinta);">
            Tia Kaka
          </span>
          <span class="text-[0.7rem] uppercase tracking-[0.2em] font-semibold" style="color: var(--color-terracota);">
            Arte que transforma
          </span>
        </span>
      </a>

      <ul class="hidden lg:flex items-center gap-8 font-semibold">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="relative px-1 py-2 transition-colors hover:opacity-80"
              style="color: var(--color-tinta);"
            >
              {item.label}
              <span
                class="absolute left-0 right-0 -bottom-0.5 h-[2px] scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100 nav-underline"
                style="background: var(--color-terracota);"
                aria-hidden="true"
              ></span>
            </a>
          </li>
        ))}
      </ul>

      <a
        href="https://wa.me/5516991468916?text=Ol%C3%A1%2C%20Tia%20Kaka!"
        class="hidden lg:inline-flex btn btn-whatsapp text-sm px-5 py-2.5"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar no WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>

      <button
        type="button"
        id="mobile-toggle"
        class="lg:hidden relative w-12 h-12 flex items-center justify-center rounded-full transition-colors"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        style="color: var(--color-tinta);"
      >
        <span class="hamburger" aria-hidden="true">
          <span class="bar bar-top"></span>
          <span class="bar bar-mid"></span>
          <span class="bar bar-bot"></span>
        </span>
      </button>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden transition-[max-height,opacity] duration-500"
    style="max-height: 0; opacity: 0;"
    aria-hidden="true"
  >
    <div class="container-wide pb-6">
      <ul class="flex flex-col gap-1 text-lg font-semibold">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block px-4 py-3 rounded-xl transition-colors hover:bg-areia"
              style="color: var(--color-tinta);"
              data-mobile-link
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a
            href="https://wa.me/5516991468916?text=Ol%C3%A1%2C%20Tia%20Kaka!"
            class="btn btn-whatsapp w-full"
            target="_blank"
            rel="noopener noreferrer"
          >
            Falar no WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  #site-header[data-at-top="true"] {
    background: transparent;
    backdrop-filter: none;
  }
  #site-header[data-at-top="false"] {
    background: rgba(250, 246, 240, 0.85);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 2px 20px -14px rgba(44, 36, 22, 0.3);
  }

  .hamburger {
    position: relative;
    width: 22px;
    height: 18px;
    display: inline-block;
  }
  .bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.35s cubic-bezier(0.6, -0.28, 0.74, 0.05), opacity 0.2s ease, top 0.35s ease;
  }
  .bar-top { top: 2px; }
  .bar-mid { top: 8px; }
  .bar-bot { top: 14px; }

  #mobile-toggle[aria-expanded="true"] .bar-top {
    top: 8px;
    transform: rotate(45deg);
  }
  #mobile-toggle[aria-expanded="true"] .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-toggle[aria-expanded="true"] .bar-bot {
    top: 8px;
    transform: rotate(-45deg);
  }

  nav a:hover .nav-underline {
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  function updateHeader() {
    if (!header) return;
    header.dataset.atTop = window.scrollY < 24 ? 'true' : 'false';
  }
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menu');
    menu.style.maxHeight = '0px';
    menu.style.opacity = '0';
    menu.setAttribute('aria-hidden', 'true');
  }
  function openMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Fechar menu');
    menu.style.maxHeight = menu.scrollHeight + 'px';
    menu.style.opacity = '1';
    menu.setAttribute('aria-hidden', 'false');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  mobileLinks.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
